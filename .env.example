# Supabase Postgres — from Project → Connect → ORMs → Prisma
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@[pooler-host]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@[pooler-host]:5432/postgres"

AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Leave blank to fall back to local disk storage (fine for dev only)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Google OAuth Client — from Google Cloud Console → APIs & Services → Credentials
# Leave blank to disable "Continue with Google" (falls back to email/password only)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
